# Server-side only AI provider key (never exposed to the browser or the Knowledge View).
# If omitted, the backend runs in clearly labelled Grounded Deterministic Mode.
OPENROUTER_API_KEY=
# Public URL of the deployment, sent to OpenRouter as the HTTP-Referer header.
# Optional: on Vercel the production domain is used automatically; otherwise falls back to http://localhost:3000.
SITE_URL=
MODEL_NAME=google/gemma-4-26b-a4b-it:free
# Optional: requests per minute per client IP on the public API routes (default 20).
RATE_LIMIT_PER_MINUTE=20
# Optional: set to true only if demo media is served from a CDN this runtime cannot inspect (default: files must exist on disk).
MEDIA_ASSUME_AVAILABLE=
# Developer demo switch ("simulate service error"). OFF by default and always off in production builds.
# Set to true ONLY in a local, non-production run to show the switch; /api/chat enforces the same rule on the server.
NEXT_PUBLIC_ENABLE_DEV_CONTROLS=
# TEST ONLY (used by `npm run verify`): lets the test client force provider-shaped failures, missing media and a low rate limit.
# Ignored when NODE_ENV=production. Never set this on a deployed environment.
ENABLE_FAILURE_INJECTION=

# Rate limiting trusts only platform-set client IP headers (x-vercel-forwarded-for / x-real-ip).
# Set to true ONLY if your own reverse proxy overwrites x-forwarded-for (the last entry is then used).
TRUST_PROXY_HEADERS=
